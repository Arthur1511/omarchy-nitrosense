#!/usr/bin/python3
"""Stateless EC helper for the Acer Nitro AN515-55 (io.github.bobster05.nitrosense widget).

Reads live temperature / fan-speed / mode registers from the embedded
controller and applies the four fan modes the bar offers. No daemon, no
privileges beyond group `nitro` access to the EC device:

  * /dev/ec  (acpi_ec module, preferred — plain RW char device)
  * /sys/kernel/debug/ec/ec0/io  (ec_sys debugfs, fallback)

Safety: EC registers are hardware-specific. `set` refuses to write on ANY
machine whose DMI identity is not in the reviewed allowlist below (fail
closed). Reads are always allowed so the widget can still show temperatures;
an unsupported machine can write only with an explicit `--force` override.

Register map mirrors Linux-NitroSense (ECS_AN515_46-class firmware).
"""

import json
import os
import re
import sys

DEV_EC = "/dev/ec"
DEV_DEBUGFS = "/sys/kernel/debug/ec/ec0/io"
DMI_DIR = "/sys/class/dmi/id"
HWMON_DIR = "/sys/class/hwmon"

# CPU temperature fallback uses only these (kernel-owned) hwmon drivers.
CPU_HWMONS = ("coretemp", "k10temp", "zenpower", "cpu_thermal")

# Registers (AN515-55 / ECS_AN515_46).
CPU_FAN_HI = 0x13
CPU_FAN_LO = 0x14
GPU_FAN_HI = 0x15
GPU_FAN_LO = 0x16
GPU_FAN_MODE = 0x21
CPU_FAN_MODE = 0x22
NITRO_MODE = 0x2C
CPU_TEMP = 0xB0
SYS_TEMP = 0xB3
GPU_TEMP = 0xB6

CPU_FAN_AUTO, CPU_FAN_TURBO = 0x04, 0x08
GPU_FAN_AUTO, GPU_FAN_TURBO = 0x10, 0x20
NITRO_QUIET, NITRO_DEFAULT, NITRO_EXTREME = 0x00, 0x01, 0x04

ADDRS = (CPU_FAN_HI, CPU_FAN_LO, GPU_FAN_HI, GPU_FAN_LO, GPU_FAN_MODE,
         CPU_FAN_MODE, NITRO_MODE, CPU_TEMP, SYS_TEMP, GPU_TEMP)

_MAX_ADDR = 0xFF

# Reviewed allowlist of EC firmware families. Each entry is a normalized
# (lowercase, alphanumeric-only) substring matched against the normalized
# DMI product name; the system vendor must be Acer. Only families whose
# register map was verified on real hardware may be added here.
# AN515-42 uses the same ECS_AN515_46-class firmware as AN515-44/46/54/56/57/58/AN517-55
SUPPORTED = ("an51555", "an51542")


def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())


def read_dmi():
    out = {}
    for key in ("sys_vendor", "product_name", "product_version",
                "board_name", "board_vendor"):
        try:
            with open(os.path.join(DMI_DIR, key)) as f:
                out[key] = f.read().strip()
        except OSError:
            out[key] = ""
    return out


def hw_supported(dmi):
    product = norm(dmi.get("product_name", ""))
    if not product or "acer" not in norm(dmi.get("sys_vendor", "")):
        return False
    return any(frag in product for frag in SUPPORTED)


def open_ec():
    for path in (DEV_EC, DEV_DEBUGFS):
        if os.path.exists(path):
            try:
                return open(path, "r+b", buffering=0)
            except OSError:
                continue
    return None


def read_reg(fd, addr):
    fd.seek(addr)
    data = fd.read(1)
    return data[0] if data else None


def write_reg(fd, addr, value):
    fd.seek(addr)
    fd.write(bytes((value,)))


def _cpu_hwmon_temp():
    """CPU temperature fallback read straight from the kernel's hwmon sysfs.

    Deliberately avoids exec()ing `sensors` (no interpreter, shell, PATH lookup
    or external binary). Returns °C as a float, or None when no matching
    driver is present.
    """
    best = None
    try:
        entries = sorted(os.listdir(HWMON_DIR))
    except OSError:
        return None
    for entry in entries:
        base = os.path.join(HWMON_DIR, entry)
        try:
            with open(os.path.join(base, "name")) as f:
                driver = f.read().strip()
        except OSError:
            continue
        if driver not in CPU_HWMONS:
            continue
        try:
            files = os.listdir(base)
        except OSError:
            continue
        for name in files:
            if not (name.startswith("temp") and name.endswith("_input")):
                continue
            try:
                with open(os.path.join(base, name)) as f:
                    value = int(f.read().strip())
            except (OSError, ValueError):
                continue
            if best is None or value > best:
                best = value
    return best / 1000.0 if best is not None else None


def read_status(fd, dmi, writes_allowed=None):
    vals = {}
    for addr in ADDRS:
        vals[addr] = read_reg(fd, addr)

    def rpm(hi, lo):
        h, l = vals.get(hi), vals.get(lo)
        if h is None or l is None:
            return None
        return (l << 8) | h

    return {
        "ec": True,
        "device": fd.name,
        "model": dmi.get("product_name", ""),
        "hwSupported": hw_supported(dmi),
        "writesAllowed": hw_supported(dmi) if writes_allowed is None else writes_allowed,
        "cpuTemp": vals.get(CPU_TEMP),
        "gpuTemp": vals.get(GPU_TEMP),
        "sysTemp": vals.get(SYS_TEMP),
        "cpuFanRpm": rpm(CPU_FAN_HI, CPU_FAN_LO),
        "gpuFanRpm": rpm(GPU_FAN_HI, GPU_FAN_LO),
        "cpuMode": vals.get(CPU_FAN_MODE),
        "gpuMode": vals.get(GPU_FAN_MODE),
        "nitroMode": vals.get(NITRO_MODE),
    }


def degraded_status(reason, dmi):
    cpu = _cpu_hwmon_temp()
    supported = hw_supported(dmi)
    return {
        "ec": False,
        "error": reason,
        "device": None,
        "model": dmi.get("product_name", ""),
        "hwSupported": supported,
        "writesAllowed": False,
        "cpuTemp": round(cpu) if cpu is not None else None,
        "gpuTemp": None,
        "sysTemp": None,
        "cpuFanRpm": None,
        "gpuFanRpm": None,
        "cpuMode": None,
        "gpuMode": None,
        "nitroMode": None,
    }


def fans_auto(fd):
    write_reg(fd, CPU_FAN_MODE, CPU_FAN_AUTO)
    write_reg(fd, GPU_FAN_MODE, GPU_FAN_AUTO)


def fans_turbo(fd):
    write_reg(fd, CPU_FAN_MODE, CPU_FAN_TURBO)
    write_reg(fd, GPU_FAN_MODE, GPU_FAN_TURBO)


MODES = {
    "auto": lambda fd: (fans_auto(fd), None),
    "quiet": lambda fd: (write_reg(fd, NITRO_MODE, NITRO_QUIET), fans_auto(fd)),
    "balance": lambda fd: (write_reg(fd, NITRO_MODE, NITRO_DEFAULT), fans_auto(fd)),
    "game": lambda fd: (write_reg(fd, NITRO_MODE, NITRO_EXTREME), fans_turbo(fd)),
}


def main():
    args = [a for a in sys.argv[1:] if a != "--force"]
    forced = "--force" in sys.argv[1:]
    dmi = read_dmi()

    if not args:
        print(json.dumps(degraded_status(
            "usage: nitro-ec [status|set <auto|quiet|balance|game>] [--force]", dmi)))
        return 1

    if args[0] == "set" and (len(args) < 2 or args[1] not in MODES):
        print(json.dumps(degraded_status("unknown mode", dmi)))
        return 1

    fd = open_ec()
    if fd is None:
        reason = f"EC unavailable: {DEV_EC} missing (run setup.sh)"
        print(json.dumps(degraded_status(reason, dmi)))
        return 1

    try:
        # Fail closed before every write: refuse unless the DMI identity
        # matches the reviewed allowlist (or the user forced --force).
        if args[0] == "set":
            supported = hw_supported(dmi)
            if not supported:
                if forced:
                    print("WARNING: forcing EC writes on unsupported hardware; "
                          "register offsets are firmware-specific and may "
                          "damage the EC. Verified on: " +
                          ", ".join(SUPPORTED), file=sys.stderr)
                else:
                    result = read_status(fd, dmi, writes_allowed=False)
                    result["error"] = ("device not in allowlist — EC writes disabled "
                                       "(use --force at your own risk)")
                    print(json.dumps(result))
                    return 1

        if args[0] == "set":
            MODES[args[1]](fd)
        result = read_status(fd, dmi)
        result["writesAllowed"] = result["hwSupported"] or forced
        print(json.dumps(result))
        return 0
    except OSError as exc:
        result = degraded_status(f"EC: {exc}", dmi)
        print(json.dumps(result))
        return 1
    finally:
        fd.close()


if __name__ == "__main__":
    sys.exit(main())